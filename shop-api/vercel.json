{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [{ "source": "/order", "destination": "/api/order" }],
  "redirects": [{ "source": "/", "destination": "https://justice.engineering/shop/", "permanent": false }]
}
